{
  "private": true,
  "browser": "./build/dist/main.js",
  "files": [
    "build/dist/**"
  ],
  "scripts": {
    "clean": "shx rm -rf ./build",
    "build": "run-s build:resources build:compile build:bundle build:static",
    "build:resources": "cpx \"src/**/*.{css}\" build/temp -v",
    "build:compile": "tsc --project src/tsconfig.json",
    "build:bundle": "rollup --config ./rollup.config.mjs",
    "build:static": "cpx \"src/**/*.{html,ico}\" build/dist -v",
    "watch": "run-p -cl watch:resources watch:compile watch:bundle watch:static",
    "watch:resources": "cpx \"src/**/*.{css}\" build/temp -v --watch",
    "watch:compile": "tsc --project src/tsconfig.json --watch --pretty",
    "watch:bundle": "rollup --config ./rollup.config.mjs --watch --waitForBundleInput",
    "watch:static": "cpx \"src/**/*.{html,ico}\" build/dist -v --watch",
    "serve": "node ./tools/serve.mjs localhost 8080",
    "serve-to-lan": "node ./tools/serve.mjs 0.0.0.0 8080"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@types/paho-mqtt": "1.0.6",
    "cpx2": "^4.2.0",
    "express": "^4.18.2",
    "npm-run-all": "^4.1.5",
    "rollup": "^3.17.1",
    "shx": "^0.3.4",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "paho-mqtt": "^1.1.0"
  }
}
